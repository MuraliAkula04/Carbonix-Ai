# Carbonix AI Backend Environment Configuration

# Database Connection:
# Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# SQLite fallback:
# DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth Token Signing
JWT_SECRET="carbonix-ai-super-secret-jwt-token-2026-secure-key"

# Port for Backend REST API
PORT=5000

# Client URL for CORS
CLIENT_URL="http://localhost:5173"

# Optional External AI API Key (e.g. Gemini / OpenAI for sustainability assistant)
AI_API_KEY=""
